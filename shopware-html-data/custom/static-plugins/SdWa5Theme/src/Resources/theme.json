        },
        "type": "color",
        "value": "#e5231f",
        "editable": true,
        "block": "themeColors",
        "order": 300
      },
      "sw-background-color": {
        "label": {
          "de-DE": "Flächen",
          "en-GB": "Surfaces"
        },
        "type": "color",
        "value": "#fcfcfd",
        "editable": true,
        "block": "themeColors",
        "order": 400
      },
      "sw-text-color": {
        "label": {
          "de-DE": "Text",
