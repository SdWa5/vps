# Secrets
.env
# Any hand-made copy of it too. Only `.env` itself was ignored, so an `.env.bak-*`
# left behind by an edit showed up as untracked in the deploy checkout at
# /opt/docker, which is exactly what makes "is this host clean?" useless as a
# deploy precondition.
.env.*
!.env.example
rclone-config/

# Pre-git backups (contain original files with inline credentials)
backup/

# Shopware data (vendor/build/secrets stay ignored, real config tracked below)
shopware-html-data/*
!shopware-html-data/composer.json
!shopware-html-data/composer.lock
!shopware-html-data/symfony.lock
!shopware-html-data/config/
shopware-html-data/config/*
!shopware-html-data/config/packages/
!shopware-html-data/config/routes.yaml
!shopware-html-data/config/routes/
!shopware-html-data/config/services.yaml
!shopware-html-data/config/bundles.php
!shopware-html-data/custom/
shopware-html-data/custom/*
!shopware-html-data/custom/plugins/
shopware-html-data/custom/plugins/*
# Store-installed plugins, not tracked via composer.json/composer.lock
!shopware-html-data/custom/plugins/FroshLazySizes/
!shopware-html-data/custom/plugins/FroshPlatformFilterSearch/
!shopware-html-data/custom/plugins/SwagPlatformSecurity/
!shopware-html-data/custom/plugins/FroshShopmon/
shopware-mysql-data/
shopware-data/

# Dolibarr SdWa5 data
dolibarr-mariadb-data/
dolibarr-documents-data/
dolibarr-custom-data/

# Dolibarr Project 2 data
project2-dolibarr-mariadb-data/
project2-dolibarr-documents-data/
project2-dolibarr-custom-data/

# Dolibarr Project 3 data
project3-dolibarr-mariadb-data/
project3-dolibarr-documents-data/
project3-dolibarr-custom-data/

# Other service data
vaultwarden-data/
# Pre-update snapshots written by monitoring/vaultwarden-autoupdate.sh. Without
# this the deploy checkout at /opt/docker always reports a dirty tree, which
# makes "is this host clean?" useless as a deploy precondition.
vaultwarden-data.bak-*/
vaultwarden-db-backup/
ollama-data/

# Minecraft data (world/mods/logs stay ignored, server config tracked below)
minecraft-data/*
# server.properties is NOT tracked. It is generated by the image rather than
# written by hand, and it carries two machine-generated secrets:
# rcon.password, which scripts/start-configuration regenerates with
# `openssl rand -hex 12` on every start because RCON_PASSWORD is unset here,
# and management-server-secret. See minecraft-data/server.properties.example
# and docs/minecraft.md.
!minecraft-data/server.properties.example
!minecraft-data/eula.txt
!minecraft-data/ops.json
!minecraft-data/whitelist.json
!minecraft-data/banned-players.json
!minecraft-data/banned-ips.json
!minecraft-data/config/
# Discord bot token lives here - never commit
minecraft-data/config/Discord-Integration.toml

# Empty build dirs (nothing to commit)
docker/

# Backup of original compose before credential extraction
docker-compose.bak.yml
