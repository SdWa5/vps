#!/usr/bin/env bash
# Fake git.
#
# vps-health.sh uses only "-C <dir> ls-remote origin HEAD".
# chimodiazz-deploy.sh additionally uses rev-parse, fetch and reset.
#
# STUB_GIT_LSREMOTE_RC drives the ls-remote outcome and STUB_GIT_LOG records the calls, which is how
# the once-a-day cadence is tested: the assertion is the number of calls, not the reported status.
#
# For the deploy script the two commits are what matter. STUB_GIT_LOCAL is HEAD in the checkout and
# STUB_GIT_REMOTE is origin/<branch>; equal values mean "nothing to deploy", which is the ordinary
# run. STUB_GIT_REMOTE unset deliberately means the ref does not resolve, so the "branch gone" path
# can be reached without inventing a separate flag.
#
# STUB_GIT_FETCH_ERR is what a failing fetch prints to stderr. The deploy script reads it, because
# git names a branch that is gone from the remote only there.
#
# STUB_GIT_DIFF_FILES is the file list a diff between the two commits would report, and the stub
# applies the pathspec after `--` to it the way real git would. Without that the path filter would
# be tested against a stub that always agrees with it.
[[ -n "${STUB_GIT_LOG:-}" ]] && printf '%s\n' "$*" >> "$STUB_GIT_LOG"

args="$*"

case "$args" in
    *"diff --name-only"*)
        rc="${STUB_GIT_DIFF_RC:-0}"
        (( rc != 0 )) && exit "$rc"
        specs="${args##*-- }"
        for f in ${STUB_GIT_DIFF_FILES-shopware/custom/plugins/ChimodiazzTheme/theme.json}; do
            for spec in $specs; do
                [[ "$f" == "$spec"* ]] && { printf '%s\n' "$f"; break; }
            done
        done
        exit 0
        ;;
    *"rev-parse --abbrev-ref HEAD"*)
        printf '%s\n' "${STUB_GIT_BRANCH-main}"
        exit 0
        ;;
    *"rev-parse origin/"*)
        [[ -z "${STUB_GIT_REMOTE+set}" ]] && exit 128
        printf '%s\n' "$STUB_GIT_REMOTE"
        exit 0
        ;;
    *"rev-parse HEAD"*)
        printf '%s\n' "${STUB_GIT_LOCAL:-1111111111111111111111111111111111111111}"
        exit 0
        ;;
    *fetch*)
        [[ -n "${STUB_GIT_FETCH_ERR:-}" ]] && printf '%s\n' "$STUB_GIT_FETCH_ERR" >&2
        exit "${STUB_GIT_FETCH_RC:-0}"
        ;;
    *reset*)
        exit "${STUB_GIT_RESET_RC:-0}"
        ;;
esac

for arg in "$@"; do
    if [[ "$arg" == "ls-remote" ]]; then
        rc="${STUB_GIT_LSREMOTE_RC:-0}"
        [[ "$rc" == "0" ]] && printf '5a5d5fe6584507affeadfb6966f2cecac7ed6915\tHEAD\n'
        exit "$rc"
    fi
done
exit 0
