        "editable": true,
        "block": "themeColors",
        "order": 600
      },
      "sw-border-color": {
        "label": {
          "de-DE": "Rahmen",
          "en-GB": "Borders"
        },
        "type": "color",
        "value": "#e1e1e9",
        "editable": true,
        "block": "themeColors",
        "order": 700
      },
      "sw-font-family-base": {
        "label": {
          "de-DE": "Textschrift",
          "en-GB": "Body font"
        },
        "type": "fontFamily",
        "value": "'DM Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
        "editable": true,
        "block": "typography",
        "order": 100
      },
      "sw-font-family-headline": {
