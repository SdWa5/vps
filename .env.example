# Copy to .env and fill in values. Never commit .env.

# Vaultwarden
# Argon2 PHC hash of the admin token, NOT plaintext — single-quote it (contains $).
# Generate: echo -n '<token>' | argon2 "$(openssl rand -base64 32)" -e -id -k 65540 -t 3 -p 4
VAULTWARDEN_ADMIN_TOKEN=''

# Dolibarr SdWa5
DOLIBARR_MYSQL_ROOT_PASSWORD=
DOLIBARR_MYSQL_PASSWORD=
DOLIBARR_ADMIN_PASSWORD=
DOLIBARR_CRON_KEY=

# Restic backup
RESTIC_PASSWORD=

# Dolibarr Project 2
PROJECT2_MYSQL_ROOT_PASSWORD=
PROJECT2_MYSQL_PASSWORD=
PROJECT2_ADMIN_PASSWORD=
PROJECT2_CRON_KEY=

# Dolibarr Project 3
PROJECT3_MYSQL_ROOT_PASSWORD=
PROJECT3_MYSQL_PASSWORD=
PROJECT3_ADMIN_PASSWORD=
PROJECT3_CRON_KEY=

# Monitoring (docs/monitoring.md)
# Gmail app password for MONITOR_SMTP_USER. Vaultwarden already holds the same
# value; copy it across without printing it:
#   python3 -c 'import json;print("MONITOR_SMTP_PASSWORD="+json.load(open("/opt/docker/vaultwarden-data/config.json"))["smtp_password"])' >> .env
MONITOR_SMTP_PASSWORD=
# Optional, shown with their defaults.
#MONITOR_SMTP_USER=ripper@sdwa5.org
#MONITOR_SMTP_HOST=smtp.gmail.com
#MONITOR_SMTP_PORT=465
#MONITOR_MAIL_TO=ripper@sdwa5.org
# Health check thresholds.
#DISK_WARN=85
#DISK_CRIT=92
#BACKUP_MAX_AGE_HOURS=26
