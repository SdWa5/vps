{
  "name": "SdWa5Theme",
  "author": "Musikverein Schmeiß die Wand an 5",
  "description": {
    "de-DE": "SdWa5-Theme, portiert vom Chimodiazz-Theme, mit hellem und dunklem Modus",
    "en-GB": "SdWa5 theme, ported from the Chimodiazz theme, with a light and a dark mode"
  },
  "views": [
    "@Storefront",
    "@Plugins",
    "@SdWa5Theme"
  ],
  "style": [
    "@Storefront",
    "app/storefront/src/scss/base.scss"
  ],
  "script": [
    "@Storefront"
  ],
  "asset": [
    "@Storefront",
    "app/storefront/src/assets"
  ],
  "config": {
    "blocks": {
      "themeColors": {
        "label": {
          "de-DE": "Farben (heller Modus, der dunkle wird abgeleitet)",
          "en-GB": "Colours (light mode, dark mode is derived)"
        }
      },
      "typography": {
        "label": {
          "de-DE": "Typografie",
          "en-GB": "Typography"
        }
      },
      "donation": {
        "label": {
          "de-DE": "Freiwillige Spende",
          "en-GB": "Voluntary donation"
        }
      }
    },
    "fields": {
      "sw-color-brand-primary": {
        "label": {
          "de-DE": "SdWa5-Grün, nur für Flächen",
          "en-GB": "SdWa5 green, fills only"
        },
        "type": "color",
        "value": "#1fe51f",
        "editable": true,
        "block": "themeColors",
        "order": 100
      },
      "sw-color-brand-secondary": {
        "label": {
          "de-DE": "Logo-Rot",
          "en-GB": "Logo red"
