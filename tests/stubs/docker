#!/usr/bin/env bash
# Fake docker. Behaviour comes from STUB_* environment variables.
case "${1:-}" in
    inspect)
        # docker inspect -f '<fmt>' <name>
        name="${!#}"
        var="STUB_CONTAINER_${name}"
        echo "${!var-true healthy}"
        [[ -n "${!var-x}" ]] || exit 1
        ;;
    image)
        # docker image inspect -f '{{.Id}}' <image>
        [[ -z "${STUB_IMAGE_ID:-}" ]] && exit 1
        echo "$STUB_IMAGE_ID"
        ;;
    logs)
        printf '%s\n' "${STUB_RESTIC_LOG:-}"
        ;;
    exec)
        if [[ "$*" == *"scheduled-task:list"* ]]; then
            # docker exec shopware php bin/console scheduled-task:list
            # Unset means the command failed, which is a different finding from
            # a task list that exists but is stale.
            [[ -z "${STUB_SHOPWARE_TASKS+set}" ]] && {
                echo "Container shopware is not running"
                exit 1
            }
            printf '%s\n' "$STUB_SHOPWARE_TASKS"
        elif [[ "$*" == *"scheduled-task:run"* ]]; then
            [[ -n "${STUB_TASK_RUN_FAILS:-}" ]] && { echo "task run blew up"; exit 1; }
            echo "Scheduled tasks executed"
        elif [[ "$*" == *"messenger:consume"* ]]; then
            [[ -n "${STUB_CONSUME_FAILS:-}" ]] && { echo "consumer blew up"; exit 1; }
            echo "[OK] Consuming messages"
        elif [[ "$*" == *"restic snapshots"* ]]; then
            # docker exec restic restic snapshots --json
            # Unset means the repository cannot be reached, which is a different
            # failure from an empty repository (set to an empty JSON array).
            [[ -z "${STUB_RESTIC_SNAPSHOTS+set}" ]] && {
                echo "Fatal: unable to open config file"
                exit 1
            }
            printf '%s\n' "$STUB_RESTIC_SNAPSHOTS"
        else
            # docker exec vaultwarden /vaultwarden --version
            [[ -z "${STUB_VW_VERSION:-}" ]] && exit 1
            echo "Vaultwarden ${STUB_VW_VERSION}"
            echo "Web-Vault ${STUB_WEB_VAULT_VERSION:-2026.7.0}"
        fi
        ;;
esac
exit 0
