# Copy to .env and fill in values. Never commit .env.

# Vaultwarden
# Argon2 PHC hash of the admin token, NOT plaintext — single-quote it (contains $).
# Generate: echo -n '<token>' | argon2 "$(openssl rand -base64 32)" -e -id -k 65540 -t 3 -p 4
VAULTWARDEN_ADMIN_TOKEN=''

# Dolibarr SdWa5
DOLIBARR_MYSQL_ROOT_PASSWORD=
DOLIBARR_MYSQL_PASSWORD=
DOLIBARR_ADMIN_PASSWORD=
DOLIBARR_CRON_KEY=

# Restic backup
RESTIC_PASSWORD=
# rclone:sdwa5backup:restic-backups by default, see docs/backup.md
#RESTIC_REPOSITORY=rclone:sdwa5backup:restic-backups
# ID of the Shared Drive "SdWa5 Backup" (rclone backend drives <remote>:)
RESTIC_SHARED_DRIVE_ID=

#DATABASE_BACKUP_CONTAINERS='dolibarr_db shopware chimodiazz_shopware'
#DATABASE_BACKUP_DIR=/opt/docker/database-backup
#DATABASE_BACKUP_TIMEOUT=900
#DB_BACKUP_MAX_AGE_HOURS=26

# Dolibarr Project 2
PROJECT2_MYSQL_ROOT_PASSWORD=
PROJECT2_MYSQL_PASSWORD=
PROJECT2_ADMIN_PASSWORD=
PROJECT2_CRON_KEY=

# Dolibarr Project 3
PROJECT3_MYSQL_ROOT_PASSWORD=
PROJECT3_MYSQL_PASSWORD=
PROJECT3_ADMIN_PASSWORD=
PROJECT3_CRON_KEY=

# Monitoring (docs/monitoring.md)
# Mail goes through the Workspace SMTP relay without a login. Optional, shown
# with their defaults. MONITOR_SMTP_PASSWORD stays unset for the relay and is
# only for a server that needs a login.
#MONITOR_SMTP_HOST=smtp-relay.gmail.com
#MONITOR_SMTP_PORT=587
#MONITOR_SMTP_USER=ripper@sdwa5.org
#MONITOR_SMTP_PASSWORD=
# Alert recipients, space separated. Defaults to ripper@sdwa5.org alone.
# Any private address belongs here rather than in monitoring/lib.sh, because
# this repository is public.
#MONITOR_MAIL_TO=ripper@sdwa5.org someone@example.com
# Health check thresholds.
#DISK_WARN=85
#DISK_CRIT=92
#BACKUP_MAX_AGE_HOURS=26
# How long a published Vaultwarden release may sit unapplied before the health check warns.
# The update job runs daily at 03:00, so anything below 24 mails about every upstream release.
#VAULTWARDEN_DRIFT_GRACE_HOURS=26
# How long a successful reachability check of the checkout's git remote counts for. That call is an
# authenticated round trip and what it watches changes rarely, so once a day is the cadence. A failure
# is never stamped, so a broken remote is retried every run.
#GIT_REMOTE_MAX_AGE_HOURS=26
#GIT_REMOTE_TIMEOUT=20
# The checkout being watched. Defaults to the compose root, which is /opt/docker on the VPS.
#GIT_CHECKOUT_DIR=/opt/docker
