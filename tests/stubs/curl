#!/usr/bin/env bash
# Fake curl. Distinguishes the call shapes the scripts make.
args="$*"

# Dolibarr REST API. Must come before the mail and http_code branches, because
# doli.sh also pipes a config file into stdin and also asks for %{http_code}.
#
# The config on stdin is captured so a test can prove the key travelled in a
# header and never in the argument list.
if [[ "$args" == *"/api/index.php"* ]]; then
    cat > "${STUB_DOLI_CONFIG:-/dev/null}"
    printf '%s' "$args" > "${STUB_DOLI_ARGS:-/dev/null}"
    # A brace-heavy default inside ${...:-} needs escaping and the escape then
    # leaks into the output, so the fallback is a plain assignment.
    doli_body="${STUB_DOLI_BODY:-}"
    [[ -n "$doli_body" ]] || doli_body='{"success":{"code":200}}'
    printf '%s' "$doli_body"
    # --write-out appends the status on its own line, exactly as doli.sh asks.
    printf '\n%s' "${STUB_DOLI_CODE:-200}"
    exit "${STUB_DOLI_RC:-0}"
fi

# Shopware admin API. Canned responses come from files in STUB_SW_DIR named
# after the request path with slashes turned into underscores; anything without
# a file answers with an empty result set. Every request is appended to
# STUB_SW_LOG as "METHOD PATH BODY", which is how a test proves that a dry run
# issued no PATCH.
if [[ "$args" == *"/api/oauth/token"* ]]; then
    cat > /dev/null
    # STUB_SW_NO_TOKEN rehearses a refused grant, which must stop the script
    # before it touches anything.
    [[ -n "${STUB_SW_NO_TOKEN:-}" ]] && { printf '{"errors":[{"status":"401"}]}'; exit 0; }
    printf '{"access_token":"fake-token","token_type":"Bearer","expires_in":600}'
    exit 0
fi
if [[ "$args" == *"/api/"* && -n "${STUB_SW_DIR:-}" ]]; then
    sw_method="GET"
    sw_path=""
    sw_body=""
    prev=""
    for a in "$@"; do
        [[ "$prev" == "-X" ]] && sw_method="$a"
        [[ "$prev" == "--data" ]] && sw_body="$a"
        [[ "$a" == http*://*/api/* ]] && sw_path="/api/${a#*/api/}"
        prev="$a"
    done
    printf '%s %s %s\n' "$sw_method" "$sw_path" "$sw_body" >> "${STUB_SW_LOG:-/dev/null}"

    sw_file="$STUB_SW_DIR/${sw_path//\//_}"
    if [[ "$sw_method" != "GET" && "$sw_method" != "POST" ]]; then
        # A successful Shopware write answers 204 with an empty body.
        exit 0
    fi
    if [[ -r "$sw_file" ]]; then
        cat "$sw_file"
    else
        printf '{"data":[],"total":0}'
    fi
    exit 0
fi

# Mail delivery: send_mail pipes a config file into stdin.
if [[ "$args" == *"--config -"* ]]; then
    cat > /dev/null
    upload=""
    prev=""
    for a in "$@"; do
        [[ "$prev" == "--upload-file" ]] && upload="$a"
        prev="$a"
    done
    {
        echo "=== MAIL ==="
        [[ -r "$upload" ]] && cat "$upload"
    } >> "${STUB_MAIL_LOG:-/dev/null}"
    exit "${STUB_MAIL_RC:-0}"
fi

# GitHub release lookup. STUB_GITHUB_JSON is a raw body; STUB_GITHUB_TAG is a
# shortcut that builds a realistic release payload whose notes mention other
# versions, which is what broke the naive extraction in production.
if [[ "$args" == *"api.github.com"* ]]; then
    if [[ -n "${STUB_GITHUB_TAG:-}" ]]; then
        cat <<JSON
{
  "url": "https://api.github.com/repos/dani-garcia/vaultwarden/releases/374920992",
  "tag_name": "${STUB_GITHUB_TAG}",
  "name": "${STUB_GITHUB_TAG}",
  "body": "This update is required for clients v2026.8.0+.\r\nFixes an issue in 1.37.1 and 1.37.0.\r\nWeb-Vault 2026.7.0.",
  "draft": false
}
JSON
        exit 0
    fi
    [[ -z "${STUB_GITHUB_JSON:-}" ]] && exit 7
    printf '%s' "$STUB_GITHUB_JSON"
    exit 0
fi

# HTTP status probe.
if [[ "$args" == *"%{http_code}"* ]]; then
    printf '%s' "${STUB_HTTP_CODE:-200}"
    exit 0
fi

exit 0
