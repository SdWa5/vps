# Global options
{
    email ripper@sdwa5.org  # For Let's Encrypt notifications
}

# dockware ships Adminer, MailCatcher and PimpMyLog inside the image and wires
# them into the same Apache vhost as the shop. Measured 2026-09-15 against the
# live sdwa5.org: /adminer/ returned a database login form, /logs/ the log
# viewer, and /mailcatcher every mail the shop had sent, password-reset links
# included. All three were public since the instance went up.
#
# They are development tools with no Shopware route behind them, so a flat 404
# costs nothing and is checked before anything reaches the container. Every
# dockware site here imports this, because the second instance runs the same
# image and would otherwise repeat the exposure.
#
# handle blocks are mutually exclusive and evaluated in written order, which is
# why the proxy below each import sits in a handle of its own rather than
# floating free: it makes the precedence explicit instead of leaving it to
# Caddy's default directive order.
(block_dockware_tools) {
    # dockware's Apache also proxies /messages (the JSON of every caught mail)
    # and /assets to mailcatcher. Shopware serves nothing under either path.
    @dockware_tools path /adminer /adminer/* /mailcatcher /mailcatcher/* /logs /logs/* /messages /messages/* /assets /assets/*
    handle @dockware_tools {
        respond "Not Found" 404
    }
}

# Response headers that name the software behind each site. Caddy adds its own
# Server header and passes the upstream's through, so every site answered with
# two of them, e.g. "Caddy" plus "Apache/2.4.58 (Ubuntu)" or "Rocket". A
# deletion is deferred until the response is written, so it also catches what
# the upstream sent.
(hide_server_headers) {
    header {
        -Server
        -X-Powered-By
    }
}

# One JSON access log per site, /var/log/caddy/access-<site>.log, rolled daily
# and kept 14 days (docs/caddy.md#access-logs). Client address, user agent and
# times stay, because an incident check needs them; the Datenschutz page names
# them as server-log data. Cookies, credentials, the referrer and token values
# in the URI and in redirects are removed before a line is written. A new log
# file means validating as the caddy user first, see docs/caddy.md.
(access_log) {
    log {
        output file /var/log/caddy/access-{args[0]}.log {
            roll_interval 24h
            roll_keep 30
            roll_keep_for 336h
        }
        format filter {
            wrap json
            fields {
                request>headers>Cookie delete
                request>headers>Authorization delete
                request>headers>Proxy-Authorization delete
                request>headers>Referer delete
                request>headers>Dolapikey delete
                request>headers>Sw-Context-Token delete
                resp_headers>Set-Cookie delete
                request>uri regexp "(?i)(/share/)[^/?]+|([?&](?:access_token|token|hash|securitykey|api_key|dolapikey|passworduidhash|em)=)[^&]*" "${1}${2}REDACTED"
                resp_headers>Location regexp "(?i)(/share/)[^/?]+|([?&](?:access_token|token|hash|securitykey|api_key|dolapikey|passworduidhash|em)=)[^&]*" "${1}${2}REDACTED"
            }
        }
    }
}

# Main domain - Shopware
https://sdwa5.org {
    # First-visit browser-language redirect: German browsers land on /de.
    # Only on root path; lang_redirect cookie marks "already redirected once"
    # (Shopware switcher is URL-based, sets no cookie of its own).
    @deFirstVisit {
        path /
        header_regexp Accept-Language ^de
        not header_regexp Cookie (^|;\s*)lang_redirect=
    }
    handle @deFirstVisit {
        header +Set-Cookie "lang_redirect=1; Path=/; Max-Age=31536000; Secure; SameSite=Lax"
        redir * /de 302
    }

    import block_dockware_tools
    import hide_server_headers
    import access_log sdwa5.org

    # Content-Security-Policy for the storefront, enforced since 2026-10-25 after
    # a week of report-only, see docs/caddy.md. Shopware's storefront template
    # sends none, while the admin sends Shopware's own policy, so /admin and the
    # APIs are left alone. The policy allows sdwa5.org itself and the SoundCloud
    # player that the Music/Mixes page loads after a click; 'unsafe-inline' stays
    # because each page carries inline scripts without a nonce.
    # tests/storefront/csp.spec.ts checks this line against every page.
    @storefront not path /admin /admin/* /api /api/* /store-api /store-api/* /csp-report
    header @storefront Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src 'self' https://w.soundcloud.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /csp-report"

    # Browsers POST their violation reports here. Caddy answers them itself and
    # writes them only to their own log, without the client address; they do not
    # reach the site's access log. The report body, which names the page and the
    # blocked source, is not logged.
    @csp_report {
        method POST
        path /csp-report
    }
    handle @csp_report {
        log_name csp_report
        respond 204
    }
    log csp_report {
        output file /var/log/caddy/sdwa5-csp-report.log {
            roll_size 1MiB
            roll_keep 2
        }
        format filter {
            wrap json
            fields {
                request>remote_ip delete
                request>client_ip delete
                request>headers>Cookie delete
            }
        }
        no_hostname
    }

    handle {
        reverse_proxy https://127.0.0.1:8443 {
            # Shopware picks the sales channel by Host. Caddy 2.11 sends the
            # upstream address as Host to an HTTPS upstream, measured 2026-10-15,
            # which answers "Sales Channel Not Found"; 2.6.2 passed it through.
            header_up Host {host}
            transport http {
                tls_insecure_skip_verify
            }
        }
    }
}

# Vaultwarden. The admin panel is reachable only through an SSH tunnel to the
# loopback port, see docs/vaultwarden.md. Clients never use /admin, so a flat
# 404 costs nothing. The upstream sends no HSTS of its own, unlike Shopware.
vault.sdwa5.org {
    import hide_server_headers
    import access_log vault.sdwa5.org
    header Strict-Transport-Security "max-age=31536000"

    @admin path /admin /admin/*
    handle @admin {
        respond "Not Found" 404
    }

    handle {
        reverse_proxy localhost:8000 {
            header_up X-Real-IP {remote_host}
        }
    }
}

# Dolibarr. The REST API stays public for its clients, but the API explorer
# listed every endpoint to anyone, and /public/cron runs the scheduled jobs for
# anyone holding the cron key, which dolibarr_cron passes on the command line
# instead. See docs/dolibarr.md.
erp.sdwa5.org {
    import hide_server_headers
    import access_log erp.sdwa5.org
    header Strict-Transport-Security "max-age=31536000"

    @blocked path /api/index.php/explorer /api/index.php/explorer/* /public/cron /public/cron/*
    handle @blocked {
        respond "Not Found" 404
    }

    handle {
        reverse_proxy localhost:8002
    }
}

# Paperless-ngx, one Verein instance and one household instance, see
# docs/paperless.md. Both get the same rules:
#   - /admin is Django's admin, which no client uses, so a flat 404.
#   - HTTP basic auth is refused before it reaches the app. Paperless answers a
#     right password with "MFA required" and a wrong one with "Invalid
#     username/password", without any throttle, measured 2026-10-16 on 3.3.2.
#     That makes it a password oracle even with TOTP on. The web login and
#     /api/token/, which the mobile apps use, are throttled and stay open.
(paperless) {
    import hide_server_headers
    header Strict-Transport-Security "max-age=31536000"

    @admin path /admin /admin/*
    handle @admin {
        respond "Not Found" 404
    }

    @basic_auth header_regexp Authorization (?i)^basic\s
    handle @basic_auth {
        respond "Basic authentication is disabled, use a token" 403
    }

    handle {
        reverse_proxy {args[0]}
    }
}

paper.sdwa5.org {
    import access_log paper.sdwa5.org
    import paperless localhost:8006
}

paper.ripper.sdwa5.org {
    import access_log paper.ripper.sdwa5.org
    import paperless localhost:8007
}

# chimodiazz.sdwa5.org — Shopware as a CMS, same shape as sdwa5.org above.
# Switched off since 2026-10-24 (PHP security release of 2026-10-21), so the
# static placeholder from chimodiazz-placeholder/ is served again, as it was
# between 2026-09-15 and the first start of the container. The way back is
# this handle body, see docs/chimodiazz.md:
#
#     reverse_proxy https://127.0.0.1:8444 {
#         # Shopware picks the sales channel by Host. Caddy 2.11 sends the
#         # upstream address as Host to an HTTPS upstream, measured 2026-10-15,
#         # which answers "Sales Channel Not Found"; 2.6.2 passed it through.
#         header_up Host {host}
#         transport http {
#             tls_insecure_skip_verify
#         }
#     }
chimodiazz.sdwa5.org {
    import block_dockware_tools
    import hide_server_headers
    import access_log chimodiazz.sdwa5.org

    handle {
        root * /opt/docker/chimodiazz-placeholder
        file_server
    }
}
