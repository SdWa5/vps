#!/usr/bin/env bash
# Fake iptables. "-S <chain>" dumps a per-chain variable, so a test can express
# any shape including an empty one, which is how a missing chain is expressed.
#
#   STUB_IPT_V4          the INPUT chain
#   STUB_IPT_DOCKER_USER the DOCKER-USER chain
if [[ "${1:-}" == "-S" ]]; then
    case "${2:-INPUT}" in
        DOCKER-USER) var=STUB_IPT_DOCKER_USER ;;
        *)           var=STUB_IPT_V4 ;;
    esac
    printf '%s' "${!var-}"
    [[ -n "${!var-}" ]] && printf '\n'
    exit 0
fi
exit 0
