# Global options
{
    email ripper@sdwa5.org  # For Let's Encrypt notifications
}

# dockware ships Adminer, MailCatcher and PimpMyLog inside the image and wires
# them into the same Apache vhost as the shop. Measured 2026-09-15 against the
# live sdwa5.org: /adminer/ returned a database login form, /logs/ the log
# viewer, and /mailcatcher every mail the shop had sent, password-reset links
# included. All three were public since the instance went up.
#
# They are development tools with no Shopware route behind them, so a flat 404
# costs nothing and is checked before anything reaches the container. Every
# dockware site here imports this, because the second instance runs the same
# image and would otherwise repeat the exposure.
#
# handle blocks are mutually exclusive and evaluated in written order, which is
# why the proxy below each import sits in a handle of its own rather than
# floating free: it makes the precedence explicit instead of leaving it to
# Caddy's default directive order.
(block_dockware_tools) {
    @dockware_tools path /adminer /adminer/* /mailcatcher /mailcatcher/* /logs /logs/*
    handle @dockware_tools {
        respond "Not Found" 404
    }
}

# Response headers that name the software behind each site. Caddy adds its own
# Server header and passes the upstream's through, so every site answered with
# two of them, e.g. "Caddy" plus "Apache/2.4.58 (Ubuntu)" or "Rocket". A
# deletion is deferred until the response is written, so it also catches what
# the upstream sent.
(hide_server_headers) {
    header {
        -Server
        -X-Powered-By
    }
}

# Main domain - Shopware
https://sdwa5.org {
    # First-visit browser-language redirect: German browsers land on /de.
    # Only on root path; lang_redirect cookie marks "already redirected once"
    # (Shopware switcher is URL-based, sets no cookie of its own).
    @deFirstVisit {
        path /
        header_regexp Accept-Language ^de
        not header_regexp Cookie (^|;\s*)lang_redirect=
    }
    handle @deFirstVisit {
        header +Set-Cookie "lang_redirect=1; Path=/; Max-Age=31536000; Secure; SameSite=Lax"
        redir * /de 302
    }

    import block_dockware_tools
    import hide_server_headers

    handle {
        reverse_proxy https://127.0.0.1:8443 {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }
}

# Vaultwarden. The admin panel is reachable only through an SSH tunnel to the
# loopback port, see docs/vaultwarden.md. Clients never use /admin, so a flat
# 404 costs nothing. The upstream sends no HSTS of its own, unlike Shopware.
vault.sdwa5.org {
    import hide_server_headers
    header Strict-Transport-Security "max-age=31536000"

    @admin path /admin /admin/*
    handle @admin {
        respond "Not Found" 404
    }

    handle {
        reverse_proxy localhost:8000 {
            header_up X-Real-IP {remote_host}
        }
    }
}

# Dolibarr. The REST API stays public for its clients, but the API explorer
# listed every endpoint to anyone, see docs/dolibarr.md.
erp.sdwa5.org {
    import hide_server_headers
    header Strict-Transport-Security "max-age=31536000"

    @api_explorer path /api/index.php/explorer /api/index.php/explorer/*
    handle @api_explorer {
        respond "Not Found" 404
    }

    handle {
        reverse_proxy localhost:8002
    }
}

project2.sdwa5.org {
    reverse_proxy localhost:8003
}

project3.sdwa5.org {
    reverse_proxy localhost:8004
}

# chimodiazz.sdwa5.org — Shopware as a CMS, same shape as sdwa5.org above.
# Served a static placeholder from chimodiazz-placeholder/ between 2026-09-15 and
# the first start of the container; that directory is kept, because it is what
# this block falls back to while the instance is down for maintenance.
chimodiazz.sdwa5.org {
    import block_dockware_tools
    import hide_server_headers

    handle {
        reverse_proxy https://127.0.0.1:8444 {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }
}
