#!/usr/bin/env bash
# Fake docker. Behaviour comes from STUB_* environment variables.
#
# STUB_DOCKER_LOG records the calls. The path filter is tested by whether
# theme:compile was reached at all, so the assertion is the absence of a call
# rather than an exit status.
#
# `docker compose` exists only with STUB_COMPOSE_PLUGIN=1, like docker-ce, and then
# hands its arguments to the docker-compose stub, so both log to STUB_COMPOSE_LOG.
# It is not logged here, so the Compose detection leaves STUB_DOCKER_LOG untouched.
if [[ "${1:-}" == compose ]]; then
    if [[ "${STUB_COMPOSE_PLUGIN:-}" != 1 ]]; then
        echo "docker: 'compose' is not a docker command." >&2
        exit 1
    fi
    [[ "${2:-}" == version ]] && { echo "Docker Compose version v5.6.0"; exit 0; }
    exec docker-compose "${@:2}"
fi

[[ -n "${STUB_DOCKER_LOG:-}" ]] && printf '%s\n' "$*" >> "$STUB_DOCKER_LOG"

case "${1:-}" in
    inspect)
        if [[ "$*" == *'{{.State.StartedAt}}'* ]]; then
            # Long ago unless a test says otherwise, so the worker's boot grace
            # stays out of every test that is not about it.
            echo "${STUB_STARTED_AT:-2020-01-01T00:00:00Z}"
            exit 0
        fi
        if [[ "$*" == *'{{.Image}}'* ]]; then
            printf 'sha256:%064d\n' 0
            exit 0
        fi
        # docker inspect -f '<fmt>' <name>
        name="${!#}"
        var="STUB_CONTAINER_${name}"
        echo "${!var-true healthy}"
        [[ -n "${!var-x}" ]] || exit 1
        ;;
    image)
        # docker image inspect -f '{{.Id}}' <image>
        [[ -z "${STUB_IMAGE_ID:-}" ]] && exit 1
        echo "$STUB_IMAGE_ID"
        ;;
    top)
        # docker top <container> -eo pid,comm
        printf 'PID COMMAND\n%s' "${STUB_DOCKER_TOP:-}"
        ;;
    logs)
        if [[ "${!#}" == sdwa5-restore-* ]]; then
            [[ -n "${STUB_RESTORE_INIT_PENDING:-}" ]] \
                || echo '[Note] [Entrypoint]: MariaDB init process done. Ready for start up.'
            exit 0
        fi
        printf '%s\n' "${STUB_RESTIC_LOG:-}"
        ;;
    exec)
        if [[ "${!#}" == /var/log/mysql/error.log ]]; then
            # tools/shopware/stop-dockware.sh reads the tail of dockware's MySQL log.
            printf '%s\n' "${STUB_MYSQL_ERROR_LOG:-}"
        elif [[ "${!#}" == probe ]]; then
            cat >/dev/null
            if [[ "${STUB_DATABASE_FAIL:-}" == probe ]]; then
                echo 'sensitive database diagnostic' >&2
                exit 1
            fi
            printf 'app\t8.0.46\t2\t%s\t%s\n' "${STUB_NONTRANSACTIONAL_TABLES:-0}" \
                "${STUB_DUPLICATE_FOREIGN_KEYS:-0}"
        elif [[ "$*" == 'exec -i fkdb '* ]]; then
            # tools/mariadb/recreate-foreign-keys.sh sends its SQL on stdin.
            sql="$(cat)"
            if [[ "$sql" == *'HAVING COUNT(*) > 1'* ]]; then
                echo "${STUB_FK_DUPLICATES:-0}"
            elif [[ "$sql" == *KEY_COLUMN_USAGE* ]]; then
                if [[ -f "$STUB_FK_APPLIED" && -n "${STUB_FK_SNAPSHOT_AFTER:-}" ]]; then
                    printf '%s\n' "$STUB_FK_SNAPSHOT_AFTER"
                else
                    printf '%s\n' "$STUB_FK_SNAPSHOT"
                fi
            else
                printf '%s\n' "$sql" > "$STUB_FK_APPLIED"
                exit "${STUB_FK_APPLY_FAIL:-0}"
            fi
        elif [[ "${!#}" == dump || "${!#}" == dump-tables ]]; then
            cat >/dev/null
            if [[ "${STUB_DATABASE_FAIL:-}" == routine_metadata && "${!#}" == dump ]]; then
                echo 'Column count of mysql.proc is wrong' >&2
                exit 1
            fi
            if [[ "${STUB_DATABASE_FAIL:-}" == dump ]]; then
                echo 'sensitive database diagnostic' >&2
                exit 1
            fi
            printf 'CREATE DATABASE app; USE app; CREATE TABLE records (id INT PRIMARY KEY);\n'
        elif [[ "$*" == *sdwa5-restore-* ]]; then
            if [[ "$*" == *'CHECK TABLE'* ]]; then
                # STUB_RESTORE_CHECK_RESULT replaces the Msg_type and Msg_text columns.
                printf 'app.records\tcheck\t%s\n' "${STUB_RESTORE_CHECK_RESULT:-$'status\tOK'}"
            elif [[ "$*" == *"TABLE_TYPE = 'BASE TABLE'"* ]]; then
                # Literal backticks, as the client prints the quoted identifiers.
                # shellcheck disable=SC2016
                printf '`records`\n`other`\n'
            elif [[ "$*" == *'SELECT COUNT(*)'* ]]; then
                echo "${STUB_RESTORE_TABLES:-2}"
            elif [[ "$*" == *'--execute=SELECT 1'* ]]; then
                echo 1
            else
                cat >/dev/null
                if [[ "${STUB_RESTORE_IMPORT_FAIL:-0}" == 1 ]]; then
                    echo 'sensitive restored row' >&2
                    exit 1
                fi
            fi
        elif [[ "$*" == *"scheduled-task:list"* ]]; then
            # docker exec shopware php bin/console scheduled-task:list
            # Unset means the command failed, which is a different finding from
            # a task list that exists but is stale.
            [[ -z "${STUB_SHOPWARE_TASKS+set}" ]] && {
                echo "Container shopware is not running"
                exit 1
            }
            printf '%s\n' "$STUB_SHOPWARE_TASKS"
        elif [[ "$*" == *"mysqladmin"*"ping"* ]]; then
            [[ -n "${STUB_DB_PING_FAILS:-}" ]] && exit 1
            echo "mysqld is alive"
        elif [[ "$*" == *"scheduled-task:run"* ]]; then
            [[ -n "${STUB_TASK_RUN_FAILS:-}" ]] && { echo "task run blew up"; exit 1; }
            echo "Scheduled tasks executed"
        elif [[ "$*" == *"messenger:consume"* ]]; then
            [[ -n "${STUB_CONSUME_FAILS:-}" ]] && { echo "consumer blew up"; exit 1; }
            echo "[OK] Consuming messages"
        elif [[ "$*" == *"plugin:refresh"* ]]; then
            [[ -n "${STUB_PLUGIN_REFRESH_FAILS:-}" ]] && { echo "refresh blew up"; exit 1; }
            echo "3 plugins, 2 installed"
        elif [[ "$*" == *"plugin:update"* ]]; then
            # Non-zero when there is nothing to update, which the caller ignores
            # on purpose. Default to that, because it is the ordinary case.
            [[ -n "${STUB_PLUGIN_UPDATE_OK:-}" ]] || exit 1
            echo "Updated 1 plugin(s)."
        elif [[ "$*" == *"theme:compile"* ]]; then
            [[ -n "${STUB_THEME_COMPILE_FAILS:-}" ]] && { echo "sass exploded"; exit 1; }
            echo "Start theme compilation"
        elif [[ "$*" == *"rm -rf var/cache"* ]]; then
            # The retry empties the cache directory before asking again.
            exit 0
        elif [[ "$*" == *"cache:clear"* ]]; then
            # STUB_CACHE_CLEAR_FAIL_ONCE names a marker file, so the first call
            # fails and the retry succeeds. That is the cache race of
            # 2026-09-16, where a rollback was the wrong answer.
            if [[ -n "${STUB_CACHE_CLEAR_FAIL_ONCE:-}" && ! -f "$STUB_CACHE_CLEAR_FAIL_ONCE" ]]; then
                : > "$STUB_CACHE_CLEAR_FAIL_ONCE"
                echo "Failed opening required 'var/cache/prod_x/url_matching_routes.php'"
                exit 1
            fi
            [[ -n "${STUB_CACHE_CLEAR_FAILS:-}" ]] && { echo "cache clear blew up"; exit 1; }
            echo "[OK] Cache was successfully cleared."
        elif [[ "$*" == *"restic snapshots"* ]]; then
            # docker exec restic restic snapshots --json
            # Unset means the repository cannot be reached, which is a different
            # failure from an empty repository (set to an empty JSON array).
            [[ -z "${STUB_RESTIC_SNAPSHOTS+set}" ]] && {
                echo "Fatal: unable to open config file"
                exit 1
            }
            printf '%s\n' "$STUB_RESTIC_SNAPSHOTS"
        else
            # docker exec vaultwarden /vaultwarden --version
            [[ -z "${STUB_VW_VERSION:-}" ]] && exit 1
            echo "Vaultwarden ${STUB_VW_VERSION}"
            echo "Web-Vault ${STUB_WEB_VAULT_VERSION:-2026.7.0}"
        fi
        ;;
esac
exit 0
