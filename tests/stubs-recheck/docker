#!/usr/bin/env bash
# Fake docker for security-recheck.sh, modelled on the containers measured on 2026-10-15, plus the
# Paperless-ngx containers of 2026-10-16 in the shape their compose networks give them.
#
# Listening ports, addresses and gateways come from the fixture table below. The probe snippet that
# security-recheck.sh runs through "docker exec SRC bash -c ..." is not executed; the stub answers
# each target as open, filtered or refused instead:
#   - "SRC>ADDRESS:PORT" listed in STUB_PROBE_OPEN is open,
#   - a container gateway (172.x.y.1) on 22, 80 or 443 is open,
#   - everything else is filtered.
# STUB_PROBE_LOG records "SRC ADDRESS:PORT" per probed target. STUB_STOPPED lists stopped containers.
# STUB_NO_BASH lists containers without bash, which the recheck probes through sh and nc instead.
#
# Environments: every container's docker inspect env holds only values the recheck must accept (a
# *_FILE path, dockware's not-set, an argon2 hash, an empty token). STUB_CONFIG_ENV_LEAK adds
# "container:NAME" entries as NAME=leaked. "docker top" lists three PIDs per container and writes
# their environ files under $RECHECK_PROC_ROOT: an init process, a worker, and a PID that has ended,
# with no /proc entry. The Paperless workers carry PAPERLESS_DBPASS and PAPERLESS_SECRET_KEY, the way
# s6 init-env-file exports them (measured 2026-10-16). STUB_ENVIRON_UNREADABLE lists containers whose
# worker environ cannot be read (a directory, since the tests may run as root), STUB_TOP_FAIL those
# whose "docker top" fails. STUB_EXTRA_LISTEN adds "container:port" listeners.
#
#   container            addresses                 gateways      listening ports
fixture() {
    case "$1" in
        vaultwarden)         echo "172.21.0.2|172.21.0.1|80" ;;
        shopware)            echo "172.18.0.2|172.18.0.1|80 443 3306" ;;
        chimodiazz_shopware) echo "172.23.0.2|172.23.0.1|80 443 1025 1080 3306" ;;
        dolibarr)            echo "172.19.0.2 172.20.0.3|172.19.0.1 |80" ;;
        dolibarr_cron)       echo "172.19.0.3 172.20.0.4|172.19.0.1 |" ;;
        dolibarr_db)         echo "172.20.0.2| |3306" ;;
        restic)              echo "172.22.0.2|172.22.0.1|" ;;
        paperless_sdwa5)        echo "172.24.0.2 172.25.0.4|172.24.0.1 |8000" ;;
        paperless_sdwa5_db)     echo "172.25.0.2| |3306" ;;
        paperless_sdwa5_broker) echo "172.25.0.3| |6379" ;;
        paperless_home)         echo "172.26.0.2 172.27.0.4|172.26.0.1 |8000" ;;
        paperless_home_db)      echo "172.27.0.2| |3306" ;;
        paperless_home_broker)  echo "172.27.0.3| |6379" ;;
        *) return 1 ;;
    esac
}

# The paths every application needs, open unless a test sets STUB_PROBE_OPEN itself.
DEFAULT_OPEN="dolibarr>172.20.0.2:3306 paperless_sdwa5>172.25.0.2:3306 paperless_sdwa5>172.25.0.3:6379 paperless_home>172.27.0.2:3306 paperless_home>172.27.0.3:6379"

case "${1:-}" in
    top)
        name="$2"
        fixture "$name" >/dev/null || exit 1
        [[ " ${STUB_TOP_FAIL-} " != *" $name "* ]] || exit 1
        base=$(( $(printf '%s' "$name" | cksum | cut -d' ' -f1) % 100000 * 10 ))
        init="$RECHECK_PROC_ROOT/$((base + 1))" worker="$RECHECK_PROC_ROOT/$((base + 2))"
        rm -rf "$init" "$worker"
        mkdir -p "$init" "$worker"
        printf 'PATH=/usr/bin\0HOME=/root\0' > "$init/environ"
        if [[ " ${STUB_ENVIRON_UNREADABLE-} " == *" $name "* ]]; then
            mkdir "$worker/environ"
        elif [[ "$name" == paperless_sdwa5 || "$name" == paperless_home ]]; then
            printf 'PAPERLESS_DBPASS=residual\0PAPERLESS_DBPASS_FILE=/run/sdwa5-secrets/x\0PAPERLESS_SECRET_KEY=residual\0' > "$worker/environ"
        else
            printf 'PATH=/usr/bin\0DB_PASSWORD_FILE=/run/sdwa5-secrets/x\0' > "$worker/environ"
        fi
        printf '%s\n' PID "$((base + 1))" "$((base + 2))" "$((base + 3))"
        ;;
    inspect)
        format="$3"
        name="$4"
        row="$(fixture "$name")" || exit 1
        IFS='|' read -r ips gateways _ <<<"$row"
        case "$format" in
            *State.Running*)
                if [[ " ${STUB_STOPPED-} " == *" $name "* ]]; then echo false; else echo true; fi ;;
            *IPAddress*) echo "$ips " ;;
            *Gateway*) echo "$gateways " ;;
            *Config.Env*)
                # shellcheck disable=SC2016 # a literal argon2 hash, nothing to expand
                printf '%s\n' PATH=/usr/local/bin:/usr/bin MYSQL_PASSWORD_FILE=/run/sdwa5-secrets/db_password \
                    SSH_PWD=not-set 'ADMIN_TOKEN=$argon2id$v=19$m=65540,t=3,p=4$c2FsdA$aGFzaA' EMPTY_TOKEN=
                for entry in ${STUB_CONFIG_ENV_LEAK-}; do
                    [[ "${entry%%:*}" == "$name" ]] && echo "${entry#*:}=leaked"
                done
                ;;
        esac
        ;;
    exec)
        shift
        [[ "$1" == --user ]] && shift 2
        name="$1"
        shift
        row="$(fixture "$name")" || exit 1
        if [[ "$1" == cat ]]; then
            IFS='|' read -r _ _ ports <<<"$row"
            for entry in ${STUB_EXTRA_LISTEN-}; do
                [[ "${entry%%:*}" == "$name" ]] && ports+=" ${entry#*:}"
            done
            echo "  sl  local_address rem_address   st"
            # A loopback listener and an established connection, which must both be skipped.
            echo "   0: 0100007F:0CEA 00000000:0000 0A"
            echo "   1: 020012AC:0050 010012AC:9C40 01"
            i=2
            for port in $ports; do
                printf '   %d: 00000000:%04X 00000000:0000 0A\n' "$i" "$port"
                i=$((i + 1))
            done
            exit 0
        fi
        # sh -c 'command -v bash': the probe's check for bash, which fails for STUB_NO_BASH containers.
        if [[ "$1" == sh && "$3" == "command -v bash" ]]; then
            [[ " ${STUB_NO_BASH-} " != *" $name "* ]] || exit 1
            echo /bin/bash
            exit 0
        fi
        # bash|sh -c SNIPPET probe TIMEOUT TARGET..., the shell recorded in STUB_SHELL_LOG.
        [[ -n "${STUB_SHELL_LOG:-}" ]] && printf '%s %s\n' "$name" "$1" >> "$STUB_SHELL_LOG"
        shift 5
        for target in "$@"; do
            [[ -n "${STUB_PROBE_LOG:-}" ]] && printf '%s %s\n' "$name" "$target" >> "$STUB_PROBE_LOG"
            if [[ " ${STUB_PROBE_OPEN-$DEFAULT_OPEN} " == *" $name>$target "* ]]; then
                echo "$target open"
            elif [[ "$target" =~ ^172\.[0-9]+\.[0-9]+\.1:(22|80|443)$ ]]; then
                echo "$target open"
            else
                echo "$target filtered"
            fi
        done
        ;;
esac
exit 0
