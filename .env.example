# Copy to .env and fill in values. Never commit .env.

# Vaultwarden
# Argon2 PHC hash of the admin token, NOT plaintext — single-quote it (contains $).
# Generate: echo -n '<token>' | argon2 "$(openssl rand -base64 32)" -e -id -k 65540 -t 3 -p 4
VAULTWARDEN_ADMIN_TOKEN=''

# Dolibarr SdWa5
DOLIBARR_MYSQL_ROOT_PASSWORD=
DOLIBARR_MYSQL_PASSWORD=
DOLIBARR_ADMIN_PASSWORD=
DOLIBARR_CRON_KEY=

# Restic backup
RESTIC_PASSWORD=

# Dolibarr Project 2
PROJECT2_MYSQL_ROOT_PASSWORD=
PROJECT2_MYSQL_PASSWORD=
PROJECT2_ADMIN_PASSWORD=
PROJECT2_CRON_KEY=

# Dolibarr Project 3
PROJECT3_MYSQL_ROOT_PASSWORD=
PROJECT3_MYSQL_PASSWORD=
PROJECT3_ADMIN_PASSWORD=
PROJECT3_CRON_KEY=
